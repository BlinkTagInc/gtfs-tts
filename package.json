{
  "name": "gtfs-tts",
  "description": "Review GTFS stop pronunciations to determine which stops need a tts_stop_name value.",
  "version": "0.3.2",
  "keywords": [
    "transit",
    "gtfs",
    "transportation",
    "text-to-speech",
    "accessibility"
  ],
  "private": false,
  "author": "Brendan Nee <brendan@blinktag.com>",
  "homepage": "https://github.com/BlinkTagInc/gtfs-tts",
  "bugs": {
    "url": "https://github.com/BlinkTagInc/gtfs-tts"
  },
  "repository": "git://github.com/BlinkTagInc/gtfs-tts",
  "contributors": [
    "Scott Berkley"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "gtfs-tts": "dist/bin/gtfs-tts.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "gtfs": "5.0.0-beta.0",
    "lodash-es": "^4.18.1",
    "pretty-error": "^4.0.0",
    "readline-sync": "^1.4.10",
    "sanitize-filename": "^1.6.5",
    "say": "^0.16.0",
    "untildify": "^5.0.0",
    "yargs": "^17.7.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.5",
    "@types/readline-sync": "^1.4.8",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.39.5",
    "eslint-config-xo": "^0.58.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    },
    "hooks": {
      "after:bump": "npm run build"
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.js": "prettier --write",
    "*.ts": "prettier --write",
    "*.json": "prettier --write"
  },
  "packageManager": "pnpm@12.19.0"
}
